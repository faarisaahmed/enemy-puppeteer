<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>EnemyPuppeteer</AssemblyName>
    <RootNamespace>EnemyPuppeteer</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Referenced as a plain DLL out of the BepInEx plugin folder, exactly as any other
      mod would consume it - not as a ProjectReference. That is deliberate: if this
      builds, the public API is genuinely usable from outside its own solution.
    -->
  </ItemGroup>

  <!--
    Where EnemyBehaviorApi.dll lives. BepInEx scans plugins/ recursively, so people group
    mods into subfolders freely and a single hardcoded path breaks the moment anyone tidies
    up. Set EnemyBehaviorApiPath in LocalPaths.props to point at it directly; otherwise the
    usual spots are tried in order.
  -->
  <PropertyGroup>
    <_ApiUnderPluginRoot>$(PluginRoot)/EnemyBehaviorApi/EnemyBehaviorApi.dll</_ApiUnderPluginRoot>
    <_ApiFlat>$(GamePath)/BepInEx/plugins/EnemyBehaviorApi/EnemyBehaviorApi.dll</_ApiFlat>

    <EnemyBehaviorApiPath Condition="'$(EnemyBehaviorApiPath)' == '' AND Exists('$(_ApiUnderPluginRoot)')">$(_ApiUnderPluginRoot)</EnemyBehaviorApiPath>
    <EnemyBehaviorApiPath Condition="'$(EnemyBehaviorApiPath)' == '' AND Exists('$(_ApiFlat)')">$(_ApiFlat)</EnemyBehaviorApiPath>
  </PropertyGroup>

  <Target Name="CheckApiReference" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(EnemyBehaviorApiPath)' == '' Or !Exists('$(EnemyBehaviorApiPath)')">
    <Error Text="EnemyBehaviorApi.dll not found. Install the Enemy Behavior API, or set &lt;EnemyBehaviorApiPath&gt; in LocalPaths.props to its full path. Looked in: $(_ApiUnderPluginRoot) and $(_ApiFlat)" />
  </Target>

  <ItemGroup>
    <Reference Include="EnemyBehaviorApi">
      <HintPath>$(EnemyBehaviorApiPath)</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="BepInEx">
      <HintPath>$(GamePath)/BepInEx/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)/BepInEx/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PlayMaker">
      <HintPath>$(ManagedPath)/PlayMaker.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedPath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(ManagedPath)/UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(PluginRoot)/EnemyPuppeteer/" />
  </Target>

</Project>
